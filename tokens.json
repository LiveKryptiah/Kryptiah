{
  "name": "Awesomic Design System Tokens",
  "theme": "light",
  "colors": {
    "obsidian": { "value": "#09090b", "description": "Primary action buttons, hero headlines, dominant text" },
    "graphite": { "value": "#18181b", "description": "Body text, nav text, badge text" },
    "slate": { "value": "#27272a", "description": "Secondary headings and elevated card surfaces" },
    "iron": { "value": "#3f3f46", "description": "Muted text, button labels on light surfaces, badge text" },
    "steel": { "value": "#52525b", "description": "Icon strokes, supporting metadata" },
    "fog": { "value": "#71717a", "description": "Helper text, tertiary labels" },
    "ash": { "value": "#a1a1aa", "description": "Placeholder text, disabled labels, light icon strokes" },
    "mist": { "value": "#d4d4d8", "description": "Subtle borders, secondary card fills, link pill backgrounds" },
    "cloud": { "value": "#ececee", "description": "Primary border color across the system (1px hairline rules)" },
    "paper": { "value": "#f4f4f5", "description": "Canvas background, card surfaces, badge fills" },
    "snow": { "value": "#ffffff", "description": "Elevated surfaces, input fields, button backgrounds" },
    "ember": { "value": "#ff5a00", "description": "Accent badges (YC batch tags, highlight chips)" },
    "magentaSpark": { "value": "#fe45e2", "description": "Rare decorative card accent" }
  },
  "typography": {
    "fontFamily": {
      "primary": "Cosmica",
      "fallback": ["DM Sans", "ui-sans-serif", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"]
    },
    "scale": {
      "caption": { "fontSize": "12px", "lineHeight": 1.64 },
      "body": { "fontSize": "15px", "lineHeight": 1.45 },
      "bodyLg": { "fontSize": "18px", "lineHeight": 1.45 },
      "subheading": { "fontSize": "20px", "lineHeight": 1.5 },
      "headingSm": { "fontSize": "32px", "lineHeight": 1.5 },
      "heading": { "fontSize": "40px", "lineHeight": 1.28 },
      "headingLg": { "fontSize": "56px", "lineHeight": 1.28 },
      "display": { "fontSize": "64px", "lineHeight": 1.12 }
    },
    "fontWeight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "28": "28px",
    "32": "32px",
    "36": "36px",
    "40": "40px",
    "48": "48px",
    "64": "64px",
    "68": "68px",
    "80": "80px",
    "120": "120px"
  },
  "borderRadius": {
    "cards": "36px",
    "icons": "40px",
    "pills": "10000px",
    "badges": "12px",
    "inputs": "14px",
    "buttons": "14px"
  },
  "surfaces": {
    "canvas": "#f4f4f5",
    "card": "#ffffff",
    "subtleCard": "#fafafa",
    "darkSurface": "#18181b",
    "deepDark": "#27272a"
  },
  "shadows": {
    "subtle": "rgba(255, 255, 255, 0.5) 0px 0.5px 0px 0px inset, rgba(117, 123, 133, 0.4) 0px 9px 14px -5px inset, rgb(44, 46, 52) 0px 0px 0px 1.5px, rgba(0, 0, 0, 0.14) 0px 4px 6px 0px",
    "subtle2": "rgb(228, 228, 231) 0px 1px 0px 0px inset",
    "subtle3": "rgb(255, 255, 255) 0px 0.5px 0px 0px inset",
    "subtle4": "rgb(255, 255, 255) 0px -0.5px 0px 0px",
    "subtle5": "rgb(228, 228, 231) 0px -1px 0px 0px",
    "md": "rgba(0, 0, 0, 0.04) 0px 4px 12px 0px"
  },
  "layout": {
    "pageMaxWidth": "1200px",
    "sectionGap": "80px",
    "cardPadding": "28px",
    "elementGap": "8px"
  }
}
